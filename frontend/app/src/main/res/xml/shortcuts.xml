<?xml version="1.0" encoding="utf-8"?>
<!-- Static app shortcuts: long-press the launcher icon to add a task. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_task"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_add"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.dincharya.app"
            android:targetClass="com.dincharya.app.MainActivity">
            <extra
                android:name="dincharya.open"
                android:value="add" />
        </intent>
    </shortcut>
</shortcuts>
