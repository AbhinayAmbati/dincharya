    <!-- Legal -->
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_intro">Dincharya is built to respect your privacy. This policy explains what the app does, and does not do, with your information.</string>
    <string name="privacy_data_title">Your data stays on your phone</string>
    <string name="privacy_data_body">Every task, completion, snooze, focus session and setting is stored in a local database on your device. Nothing is uploaded, synced or sent anywhere. The only part of the app that touches the internet is the optional update check screen, which talks to GitHub to see if a newer version exists.</string>
    <string name="privacy_permissions_title">Permissions we use</string>
    <string name="privacy_permissions_body">Dincharya asks for the notification permission so it can remind you about tasks at the right time. Updating the app from the update screen also needs Android\'s install permission, requested only when you choose to update in place. The app never touches your contacts, location, camera, microphone or files.</string>
    <string name="privacy_learning_title">Learning happens on your phone</string>
    <string name="privacy_learning_body">Dincharya studies your habits to suggest better times and show you your patterns: best hours, habit strength, how long things really take. A small statistical model is trained on your device, from your own history, in plain code you can read. It is guidance computed for you, not about you: there is no cloud, no account, no upload, and the model cannot be exported or shared. Uninstall the app and both the history and the model are gone.</string>
    <string name="privacy_accounts_title">No accounts, no tracking</string>
    <string name="privacy_accounts_body">There is no sign-up, no analytics and no advertising. Because nothing leaves your device, there is nothing to sell, share or leak.</string>
    <string name="privacy_deletion_title">Deleting the app deletes the data</string>
    <string name="privacy_deletion_body">Uninstalling Dincharya removes every trace of your usage from the device. There is no server-side copy to worry about.</string>
    <string name="privacy_contact_title">Contact</string>
    <string name="privacy_contact_body">Questions about privacy? Write to abhinayambati4@gmail.com.</string>
    <string name="terms_title">Terms of Use</string>
    <string name="terms_intro">These terms govern your use of Dincharya. By using the app you accept them.</string>
    <string name="terms_app_title">What the app is</string>
    <string name="terms_app_body">Dincharya is a personal day planner and reminder tool. It learns from your own usage to suggest times, score habits and compare estimates with reality. Everything it computes is guidance, not a guarantee; treat it as a second opinion, never an obligation.</string>
    <string name="terms_responsibility_title">Your responsibility</string>
    <string name="terms_responsibility_body">You remain responsible for how you plan your day. Do not rely on the app for medical, legal, financial or safety-critical reminders.</string>
    <string name="terms_warranty_title">No warranty</string>
    <string name="terms_warranty_body">The app is provided as is, without warranty of any kind. To the fullest extent permitted by law, the developer is not liable for any damages arising from its use.</string>
    <string name="terms_changes_title">Changes</string>
    <string name="terms_changes_body">Future versions may update these terms. Continued use after an update means you accept the revised terms.</string>

