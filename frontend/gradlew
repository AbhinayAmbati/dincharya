#!/bin/sh
#
# Dincharya — self-bootstrapping Gradle wrapper.
#
# The Gradle wrapper JAR is NOT committed (this repository is intentionally
# text-only). On first use this script downloads the official JAR, pinned
# to the exact Gradle release tag, and then behaves exactly like the stock
# Gradle wrapper. Subsequent runs are fully offline for the wrapper itself.
#
# Requirements: a JDK on PATH (or JAVA_HOME set) and curl for the one-time
# download — the Gradle distribution itself is fetched by the wrapper anyway.

set -e

APP_HOME=$( cd "$(dirname "$0")" > /dev/null && pwd -P )
JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
WRAPPER_URL="https://raw.githubusercontent.com/gradle/gradle/v8.7.0/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$JAR" ]; then
    echo "Gradle wrapper JAR not found — downloading it once from the official Gradle repository..."
    mkdir -p "$(dirname "$JAR")"
    if ! curl -fsSL -o "$JAR" "$WRAPPER_URL"; then
        echo "ERROR: could not download the wrapper JAR. Check your network connection." >&2
        exit 1
    fi
fi

# Locate java: JAVA_HOME first, then PATH.
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
else
    JAVACMD=java
fi

exec "$JAVACMD" -cp "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
